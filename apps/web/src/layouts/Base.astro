---
import '../styles/global.css';
import { languages, langs, localizePath, sections, useTranslations, type Lang } from '../i18n/ui';
import { SITE_NAME } from '../site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${t('site.tagline')}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('site.tagline')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {langs.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(localizePath(path, l), Astro.site ?? Astro.url)}
      />
    ))}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage can be unavailable (private mode, blocked site data).
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo mono" href={`/${lang}/`}>
          (◕‿◕) {SITE_NAME}
        </a>
        <nav aria-label="Main">
          {sections.map((s) => (
            <a
              href={`/${lang}/${s}/`}
              aria-current={path.startsWith(`/${lang}/${s}`) ? 'page' : undefined}
            >
              {t(`nav.${s}`)}
            </a>
          ))}
        </nav>
        <div class="tools">
          <nav aria-label={t('lang.switch')} class="langs mono">
            {langs.map((l) => (
              <a
                href={localizePath(path, l)}
                hreflang={l}
                lang={l}
                title={languages[l]}
                aria-current={l === lang ? 'true' : undefined}
              >
                {l}
              </a>
            ))}
          </nav>
          <button
            type="button"
            class="theme-toggle mono"
            aria-label={t('theme.toggle')}
            title={t('theme.toggle')}
          >
            ◐
          </button>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="container muted mono">
      <small>
        {SITE_NAME} · {t('site.tagline')}
      </small>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      button?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage can be unavailable (private mode, blocked site data).
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  .logo {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: var(--space-3);
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--fg);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }
  .langs {
    gap: var(--space-2);
  }
  .theme-toggle {
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--fg);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }
  footer {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--line);
  }
</style>
