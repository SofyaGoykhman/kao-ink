---
import { stringWidth } from '@kaomoji/ascii-core';
import type { Kaomoji } from '../data/kaomoji';

interface Props {
  items: Kaomoji[];
}

const { items } = Astro.props;

/** Wide kaomoji take two or three grid columns instead of being cut off. */
const span = (text: string) => {
  const width = stringWidth(text);
  return width > 26 ? 3 : width > 13 ? 2 : 1;
};
---

<ul class="kaomoji-grid">
  {items.map((k) => (
    <li class={`span-${span(k.text)}`}>
      <button type="button" data-copy={k.text}>
        {k.text}
      </button>
    </li>
  ))}
</ul>

<style>
  .kaomoji-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    grid-auto-flow: row dense;
    gap: var(--space-1);
  }
  .span-2 {
    grid-column: span 2;
  }
  .span-3 {
    grid-column: span 3;
  }
  @media (max-width: 520px) {
    .span-3 {
      grid-column: span 2;
    }
  }
  button {
    width: 100%;
    height: 100%;
    min-height: 52px;
    padding: var(--space-2);
    background: var(--surface);
    color: var(--fg);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 1.05rem;
    overflow-wrap: anywhere;
    cursor: pointer;
  }
  button:hover {
    border-color: var(--fg);
  }
</style>
