---
import Base from '../../layouts/Base.astro';
import WidthChecker from '../../components/WidthChecker';
import { langs, sections, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base lang={lang}>
  <h1>{t('site.tagline')}</h1>
  <ul class="sections">
    {sections.map((s) => (
      <li>
        <a href={`/${lang}/${s}/`}>
          <h2>{t(`nav.${s}`)}</h2>
          <p class="muted">{t(`${s}.lead`)}</p>
        </a>
      </li>
    ))}
  </ul>

  <section>
    <h2>{t('width.title')}</h2>
    <p class="muted">{t('width.lead')}</p>
    <WidthChecker
      client:visible
      labels={{
        input: t('width.input'),
        columns: t('width.columns'),
        lines: t('width.lines'),
        ambiguous: t('width.ambiguous'),
      }}
    />
  </section>
</Base>

<style>
  .sections {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .sections a {
    display: block;
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .sections a:hover {
    border-color: var(--fg);
  }
  .sections h2 {
    margin: 0 0 var(--space-1);
    font-size: 1.1rem;
  }
  .sections p {
    margin: 0;
  }
</style>
