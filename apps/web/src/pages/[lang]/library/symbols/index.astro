---
import Crumbs from '../../../../components/Crumbs.astro';
import Base from '../../../../layouts/Base.astro';
import { langs, useTranslations, type Lang } from '../../../../i18n/ui';
import { blocks, groupOrder } from '../../../../data/unicode';
import SymbolSearchBox from '../../../../components/SymbolSearchBox';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const groups = groupOrder.map((group) => ({
  group,
  blocks: blocks.filter((b) => b.group === group),
}));
---

<Base lang={lang} title={t('library.symbols')} description={t('library.symbols.lead')}>
  <Crumbs items={[{ href: `/${lang}/library/`, label: t('nav.library') }]} />
  <h1>{t('library.symbols')}</h1>
  <p class="muted">{t('library.symbols.lead')}</p>
  <SymbolSearchBox
    client:load
    lang={lang}
    examples={
      lang === 'ru'
        ? ['сердечко', 'звезда', 'корона', 'стрелка вправо', 'кот']
        : ['heart', 'star', 'crown', 'right arrow', 'cat']
    }
    blockNames={Object.fromEntries(blocks.map((b) => [b.id, lang === 'ru' ? b.ru : b.name]))}
    labels={{
      placeholder: t('search.placeholder'),
      loading: t('search.loading'),
      found: t('search.found'),
      nothing: t('search.nothing'),
      copied: t('copy.done'),
      examples: t('search.examples'),
    }}
  />
  {groups.map(({ group, blocks }) => (
    <section>
      <h2>{t(`group.${group}`)}</h2>
      <ul class="blocks">
        {blocks.map((b) => (
          <li>
            {b.lazy ? (
              <span class="muted">
                {lang === 'ru' ? b.ru : b.name}{' '}
                <small>
                  · {b.count} · {t('symbols.lazy')}
                </small>
              </span>
            ) : (
              <a href={`/${lang}/library/symbols/${b.id}/`}>
                {lang === 'ru' ? b.ru : b.name} <small class="muted">· {b.count}</small>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .blocks {
    list-style: none;
    padding: 0;
    columns: 3 220px;
    column-gap: var(--space-4);
  }
  .blocks li {
    break-inside: avoid;
    padding: 2px 0;
  }
  .blocks a {
    text-decoration: none;
  }
  .blocks a:hover {
    text-decoration: underline;
  }
  h2 {
    font-size: 1.1rem;
    margin-top: var(--space-5);
  }
</style>
