---
import Base from '../../../layouts/Base.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const parts = [
  { id: 'kaomoji', sample: '(◕‿◕)', ready: true },
  { id: 'symbols', sample: '→ ★ ┼ ∞', ready: true },
  { id: 'fonts', sample: '𝓪𝓫𝓬', ready: true },
] as const;
---

<Base lang={lang} title={t('nav.library')} description={t('library.lead')}>
  <h1>{t('nav.library')}</h1>
  <p class="muted">{t('library.lead')}</p>
  <ul class="cards">
    {parts.map((p) => (
      <li>
        {p.ready ? (
          <a href={`/${lang}/library/${p.id}/`}>
            <span class="sample mono">{p.sample}</span>
            <h2>{t(`library.${p.id}`)}</h2>
            <p class="muted">{t(`library.${p.id}.lead`)}</p>
          </a>
        ) : (
          <div aria-disabled="true">
            <span class="sample mono">{p.sample}</span>
            <h2>
              {t(`library.${p.id}`)} <small class="muted">· {t('symbols.lazy')}</small>
            </h2>
            <p class="muted">{t(`library.${p.id}.lead`)}</p>
          </div>
        )}
      </li>
    ))}
  </ul>
</Base>

<style>
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .cards a,
  .cards div {
    display: block;
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .cards a:hover {
    border-color: var(--fg);
  }
  .cards div {
    opacity: 0.6;
  }
  .sample {
    font-size: 1.5rem;
  }
  h2 {
    font-size: 1.1rem;
    margin: var(--space-2) 0 var(--space-1);
  }
  p {
    margin: 0;
  }
</style>
