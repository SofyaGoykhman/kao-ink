---
import Crumbs from '../../../components/Crumbs.astro';
import Base from '../../../layouts/Base.astro';
import FancyText from '../../../components/FancyText';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('library.fonts')} description={t('library.fonts.lead')}>
  <Crumbs items={[{ href: `/${lang}/library/`, label: t('nav.library') }]} />
  <h1>{t('library.fonts')}</h1>
  <p class="muted">
    {t('library.fonts.lead')} {t('fonts.cyrillicNote')}
  </p>
  <FancyText
    client:load
    lang={lang}
    labels={{
      input: t('fonts.input'),
      sample: t('fonts.sample'),
      unsupported: t('fonts.unsupported'),
      copy: t('copy.copy'),
    }}
  />
</Base>
