---
import Base from '../../layouts/Base.astro';
import { langs, useTranslations, type Lang } from '../../i18n/ui';
import stats from '@data/unicode/out/stats.json';
import unicodeLicense from '@data/unicode/LICENSE-unicode.txt?raw';
import w33bleLicense from '@data/kaomoji/licenses/w33ble-emoticon-data.txt?raw';
import asciilibLicense from '@data/kaomoji/licenses/asciilib.txt?raw';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const sources = [
  {
    name: 'emoticon-data',
    url: 'https://github.com/w33ble/emoticon-data',
    credit: '© 2014 Joe Fleming · MIT',
    text: w33bleLicense,
  },
  {
    name: 'asciilib',
    url: 'https://github.com/iansinnott/asciilib',
    credit: '© 2022 Ian Sinnott · MIT',
    text: asciilibLicense,
  },
  {
    name: 'FontVibe kaomoji',
    url: 'https://github.com/Funovate/fontvibe-kaomoji',
    credit: 'CC0',
  },
  {
    name: `Unicode ${stats.unicodeVersion} · CLDR ${stats.cldrVersion}`,
    url: 'https://www.unicode.org/',
    credit: '© Unicode, Inc. · Unicode License v3',
    text: unicodeLicense,
  },
];
---

<Base lang={lang} title={t('licenses.title')} description={t('licenses.lead')}>
  <h1>{t('licenses.title')}</h1>
  <p class="muted">{t('licenses.lead')}</p>
  {sources.map((s) => (
    <section>
      <h2>
        <a href={s.url}>{s.name}</a>
      </h2>
      <p class="muted">{s.credit}</p>
      {s.text && (
        <details>
          <summary>License</summary>
          <pre>{s.text}</pre>
        </details>
      )}
    </section>
  ))}
</Base>

<style>
  h2 {
    font-size: 1.1rem;
    margin: var(--space-4) 0 0;
  }
  p {
    margin: var(--space-1) 0;
  }
  pre {
    white-space: pre-wrap;
    font-size: 0.8rem;
    padding: var(--space-3);
    background: var(--surface);
    border-radius: var(--radius);
  }
</style>
